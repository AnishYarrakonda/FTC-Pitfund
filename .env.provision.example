# FTC Pitfund production provisioning. Copy to .env.provision (gitignored) and fill in the
# first section. `npm run provision` writes generated values (project refs, keys, passwords,
# secrets) into the bottom of .env.provision; keep that file in the team password manager.
# Every token must be created while signed in as ftcexodius@gmail.com (docs/LAUNCH.md step 2).

# ─── Fill these in ──────────────────────────────────────────────────────────────────────
# The domain you bought (docs/LAUNCH.md step 3), without https://
PITFUND_DOMAIN=

# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Organization name (default "FTC Pitfund") or its slug
SUPABASE_ORG_NAME=FTC Pitfund
SUPABASE_ORG_SLUG=

# vercel.com/account/settings/tokens (scope: the team account)
VERCEL_TOKEN=
# Only needed if the token can see more than one team
VERCEL_TEAM_SLUG=

# resend.com/api-keys, permission "Full access" (the app itself gets a separate sending-only key)
RESEND_FULL_ACCESS_KEY=

# Comma-separated admin emails (they can sign in with Google or an email code)
ADMIN_EMAILS=ftcexodius@gmail.com

# ─── Fill in at docs/LAUNCH.md step 5 ───────────────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────────────────
# Sentry: sentry.io → Settings → Auth Tokens (org:read, project:write, project:read)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Official FIRST Events API credentials (without them team lookup uses FTCScout)
FIRST_API_USERNAME=
FIRST_API_TOKEN=
# Overrides (defaults shown)
VERCEL_PROJECT_NAME=ftc-pitfund
SUPABASE_PRODUCTION_PROJECT_NAME=ftc-pitfund
SUPABASE_STAGING_PROJECT_NAME=ftc-pitfund-staging
STAGING_BRANCH=staging
