# FTC Pitfund environment. `npm run setup` writes the local values into .env.local for you;
# production values live in the Vercel project (scripts/provision sets them in prompt 4).
# lib/server/env.ts validates these: it throws in production and warns in development.

# ─── App ───────────────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used in emails and redirects.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ─── Supabase (auth, storage) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser (auth and signed uploads only).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service-role) key: SERVER ONLY. Used by lib/server/supabase-admin.ts.
SUPABASE_SECRET_KEY=sb_secret_...
# Postgres. Production: the Supabase transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Secret for the Supabase Auth "Send Email" hook (Standard Webhooks format).
SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# ─── Google sign-in (optional locally) ────────────────────────────────────────────────
# When both are set, `npm run setup` enables Google in the local stack.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true when Google is configured for this environment (the login button explains otherwise).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Email ─────────────────────────────────────────────────────────────────────────────
# smtp (local Mailpit) or resend. Production uses resend.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=FTC Pitfund <noreply@pitfund.test>
SMTP_URL=smtp://127.0.0.1:54325
MAILPIT_URL=http://127.0.0.1:54324
RESEND_API_KEY=
# Signing secret for the Resend webhook (bounces and complaints).
RESEND_WEBHOOK_SECRET=

# ─── Jobs, errors, records ─────────────────────────────────────────────────────────────
# Vercel sends this as the Bearer token for /api/cron/daily. Required in production.
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (optional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Official FIRST Events API. Without it, team lookup uses FTCScout.
FIRST_API_USERNAME=
FIRST_API_TOKEN=
