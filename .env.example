# FTC Pitfund environment. Copy to .env.local (gitignored) and fill in section 1. That one file is
# read by the app, `npm run setup`, and every `npm run provision:*` script.
#
#   1. YOU FILL IN   tokens and choices for launch (docs/LAUNCH.md). Blank = that step waits for you.
#   2. LOCAL STACK   written by `npm run setup` (needs Docker). Leave it alone.
#   3. GENERATED     written by `npm run provision`: project refs, keys, passwords, secrets.
#
# Production's runtime variables (NEXT_PUBLIC_SUPABASE_URL, SEND_EMAIL_HOOK_SECRET, ...) live on the
# Vercel project, set by `npm run provision:vercel` from section 3. Never paste them in section 2.
# lib/server/env.ts validates the runtime ones: it throws in production and warns in development.

# ═══ 1. YOU FILL IN ════════════════════════════════════════════════════════════════════════
# The Google account you sign in to Supabase, Vercel and Resend with. Provisioning warns if a token belongs to anyone else,
# sends its "live" test email here, and uses it for the DMARC report address.
OWNER_EMAIL=anish.yarrakonda456@gmail.com
# The domain you bought (docs/LAUNCH.md step 3), without https://
PITFUND_DOMAIN=
# Comma-separated admin emails (they sign in with an email code)
ADMIN_EMAILS=ftcexodius@gmail.com, anish.yarrakonda456@gmail.com

# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Leave both blank if you only have Supabase's default personal organization
SUPABASE_ORG_NAME=
SUPABASE_ORG_SLUG=

# vercel.com/account/tokens (scope: the account that will own the project)
VERCEL_TOKEN=
# Only needed if the token can see more than one team
VERCEL_TEAM_SLUG=

# resend.com/api-keys, permission "Full access" (the app itself gets a separate sending-only key)
RESEND_FULL_ACCESS_KEY=

# Optional. Official FIRST Events API. Without it, team lookup uses FTCScout.
FIRST_API_USERNAME=
FIRST_API_TOKEN=

# Overrides (defaults shown)
VERCEL_PROJECT_NAME=ftc-pitfund
SUPABASE_PRODUCTION_PROJECT_NAME=ftc-pitfund
SUPABASE_STAGING_PROJECT_NAME=ftc-pitfund-staging
STAGING_BRANCH=staging

# ═══ 2. LOCAL STACK (npm run setup) ════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SEND_EMAIL_HOOK_SECRET=
# smtp (local Mailpit) or resend. Production uses resend, set on Vercel by provisioning.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=FTC Pitfund <noreply@pitfund.test>
SMTP_URL=smtp://127.0.0.1:54325
MAILPIT_URL=http://127.0.0.1:54324
# Local only. Production gets its own PRODUCTION_CRON_SECRET (section 3).
CRON_SECRET=
# 1 logs every database query ("[db] #n …") to count what a page render costs. Never set on Vercel.
DEBUG_QUERIES=

# ═══ 3. GENERATED (npm run provision appends its values below; do not edit) ════════════════
# SUPABASE_PRODUCTION_REF / _URL / _PUBLISHABLE_KEY / _SECRET_KEY / _DATABASE_URL /
# _SESSION_DATABASE_URL / _SEND_EMAIL_HOOK_SECRET / _DB_PASSWORD, the same for STAGING,
# PRODUCTION_CRON_SECRET, RESEND_API_KEY, RESEND_WEBHOOK_SECRET.
