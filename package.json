{
  "name": "ftc-pitfund",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/setup.ts",
    "db:generate": "NODE_OPTIONS=\"--import ./scripts/lib/server-only-stub.mjs\" drizzle-kit generate",
    "db:migrate": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/db-migrate.ts",
    "db:reset": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/db-reset.ts",
    "db:backup": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/db-backup.ts",
    "seed": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/seed/index.ts",
    "admin:grant": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/admin-grant.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test --config playwright.config.ts",
    "qa": "playwright test --config playwright.qa.config.ts",
    "knip": "knip --no-progress",
    "email:drain": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/drain-outbox.ts",
    "cron:run": "node --import tsx scripts/cron-run.ts",
    "provision": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/provision/index.ts",
    "provision:check": "node --import tsx scripts/provision/check.ts",
    "provision:supabase": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/provision/supabase.ts",
    "provision:vercel": "node --import tsx scripts/provision/vercel.ts",
    "provision:resend": "node --import tsx scripts/provision/resend.ts",
    "provision:sentry": "node --import tsx scripts/provision/sentry.ts",
    "provision:verify": "node --import tsx scripts/provision/verify.ts",
    "screenshots:marketing": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/marketing-screenshots.ts",
    "email:preview": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/email-preview.ts",
    "perf": "node --import tsx --import ./scripts/lib/server-only-stub.mjs scripts/perf.ts",
    "prod": "node --import tsx scripts/prod.ts",
    "security:scan": "node --import tsx scripts/security-scan.ts",
    "qa:clicks": "node --import tsx --import ./scripts/lib/server-only-stub.mjs tests/qa/dead-clicks.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.9.5",
    "resend": "^6.28.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "knip": "^6.35.1",
    "lighthouse": "^13.4.1",
    "supabase": "^2.117.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
